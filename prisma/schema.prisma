// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Analysis {
  id        Int      @id @default(autoincrement())
  problem   String
  constraints String?
  language  String
  code      String
  verdict   String
  confidence Float
  complexity Json
  algorithm Json
  issues Json
  edgeCases Json
  judgePrediction Json
  codeQuality Json
  hints Json
  tests Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}